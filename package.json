{
  "name": "zeynalikid-courses",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint src tests --deny-warnings",
    "test:unit": "esbuild tests/unit.test.ts --bundle --platform=node --format=esm --target=node20 --outfile=/tmp/zeynalikid-unit.test.mjs && node /tmp/zeynalikid-unit.test.mjs",
    "test": "npm run test:unit",
    "build": "tsc -b && vite build",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "preview": "vite preview",
    "test:a11y": "node tests/accessibility.mjs",
    "test:e2e:readonly": "node tests/critical-paths.mjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "5.3.0",
    "@supabase/supabase-js": "2.109.0",
    "clsx": "2.1.1",
    "framer-motion": "13.1.1",
    "jszip": "3.10.1",
    "lucide-react": "1.33.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-helmet-async": "2.0.5",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "4.13.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.25.12",
    "oxlint": "1.79.0",
    "puppeteer": "24.43.1",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
