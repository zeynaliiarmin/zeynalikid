{
  "redirects": [
    {
      "source": "/",
      "destination": "https://zeynalikid.vercel.app/form",
      "permanent": true,
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "destination": "https://zeynalikid.vercel.app/form",
      "permanent": true,
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" }
      ]
    }
  ]
}
