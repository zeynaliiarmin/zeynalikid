{
  "rewrites": [
    {
      "source": "/courses",
      "destination": "/courses/index.html"
    },
    {
      "source": "/experience",
      "destination": "/experience/index.html"
    },
    {
      "source": "/licenses",
      "destination": "/licenses/index.html"
    },
    {
      "source": "/education",
      "destination": "/education/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/products",
      "destination": "/products/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/track",
      "destination": "/spa.html"
    },
    {
      "source": "/portal",
      "destination": "/spa.html"
    },
    {
      "source": "/profile",
      "destination": "/spa.html"
    },
    {
      "source": "/growth",
      "destination": "/spa.html"
    },
    {
      "source": "/settings",
      "destination": "/spa.html"
    },
    {
      "source": "/desk",
      "destination": "/spa.html"
    },
    {
      "source": "/desk/app",
      "destination": "/spa.html"
    },
    {
      "source": "/child-info",
      "destination": "/spa.html"
    },
    {
      "source": "/course-shipping",
      "destination": "/spa.html"
    },
    {
      "source": "/course-payment",
      "destination": "/spa.html"
    },
    {
      "source": "/course-payment/verify",
      "destination": "/spa.html"
    },
    {
      "source": "/course-confirm",
      "destination": "/spa.html"
    },
    {
      "source": "/course-done",
      "destination": "/spa.html"
    },
    {
      "source": "/form",
      "destination": "/spa.html"
    },
    {
      "source": "/consultation",
      "destination": "/spa.html"
    },
    {
      "source": "/:refCode",
      "destination": "/api/referral/:refCode"
    },
    {
      "source": "/((?!assets/|api/|icons/|images/|courses/|experience/|licenses/|education/|about/|faq/|contact/|products/|privacy/|track|portal|profile|growth|settings|desk|child-info|course-shipping|course-payment|course-confirm|course-done|form|consultation|sw.js|manifest.webmanifest|favicon.ico|robots.txt|sitemap.xml|admin-sw.js|admin-manifest.webmanifest|spa.html|404.html).*)",
      "destination": "/404.html?fallback=1",
      "statusCode": 404
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss: https://challenges.cloudflare.com; frame-src https:; form-action 'self' https:; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=(self), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/admin/"
        }
      ]
    },
    {
      "source": "/admin-manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}