{
  "rewrites": [
    {
      "source": "/courses",
      "destination": "/courses/index.html"
    },
    {
      "source": "/experience",
      "destination": "/experience/index.html"
    },
    {
      "source": "/licenses",
      "destination": "/licenses/index.html"
    },
    {
      "source": "/education",
      "destination": "/education/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/products",
      "destination": "/products/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/track",
      "destination": "/spa.html"
    },
    {
      "source": "/portal",
      "destination": "/spa.html"
    },
    {
      "source": "/profile",
      "destination": "/spa.html"
    },
    {
      "source": "/growth",
      "destination": "/spa.html"
    },
    {
      "source": "/settings",
      "destination": "/spa.html"
    },
    {
      "source": "/desk",
      "destination": "/spa.html"
    },
    {
      "source": "/desk/app",
      "destination": "/spa.html"
    },
    {
      "source": "/child-info",
      "destination": "/spa.html"
    },
    {
      "source": "/course-shipping",
      "destination": "/spa.html"
    },
    {
      "source": "/course-payment",
      "destination": "/spa.html"
    },
    {
      "source": "/course-payment/verify",
      "destination": "/spa.html"
    },
    {
      "source": "/course-confirm",
      "destination": "/spa.html"
    },
    {
      "source": "/course-done",
      "destination": "/spa.html"
    },
    {
      "source": "/form",
      "destination": "/form/index.html"
    },
    {
      "source": "/consultation",
      "destination": "/consultation/index.html"
    },
    {
      "source": "/education/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|sogou|exabot|applebot|facebot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|discordbot|pinterest|google-inspectiontool|semrushbot|ahrefsbot|mj12bot|dotbot|petalbot|fresh).*"
        }
      ],
      "destination": "/api/education-ssr?slug=:slug"
    },
    {
      "source": "/education/:path*",
      "destination": "/education/index.html"
    },
    {
      "source": "/courses/:path*",
      "destination": "/courses/index.html"
    },
    {
      "source": "/products/:path*",
      "destination": "/products/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://kkdrvexwzuuumjezipnd.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:code((?!assets|api|icons|images|fonts|courses|track|portal|experience|licenses|education|about|faq|contact|products|profile|growth|settings|privacy|desk|admin|admin-login|search|child-info|course-shipping|course-payment|course-confirm|course-done|form|consultation|sw|spa|robots|sitemap|llms|favicon|manifest|admin-sw|admin-manifest|index|404|debug)[a-z0-9]+)",
      "destination": "/api/referral/:code"
    },
    {
      "source": "/((?!assets/|api/|icons/|images/|courses/|experience/|licenses/|education/|about/|faq/|contact/|products/|privacy/|sw.js|manifest.webmanifest|favicon.ico|robots.txt|sitemap.xml|llms.txt|admin-sw.js|admin-manifest.webmanifest|404.html).*)",
      "destination": "/spa.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss: https://challenges.cloudflare.com; frame-src https:; form-action 'self' https:; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=(self), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/track",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/portal",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/admin/"
        }
      ]
    },
    {
      "source": "/admin-manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000"
        }
      ]
    },
    {
      "source": "/(courses|experience|licenses|education|about|faq|contact|products|privacy|index.html|$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}