# Zeynalikid main — متغیرهای محیطی نمونه (کپی کنید به .env و مقدار بدهید)
# اتصال Supabase (جدول‌ها: submissions, settings, profiles, growth_tracking, wishlist, reviews, education_items)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# رمز اضطراری پنل مدیریت (اختیاری — در غیر این صورت از settings استفاده می‌شود)
VITE_ADMIN_PASSWORD=
# آدرس متقابل دو اپ برای لینک‌های بین دامنه‌ای
VITE_APP_A_URL=https://zeynalikid-form.vercel.app
VITE_APP_B_URL=https://zeynalikid.vercel.app
